@@ -182,6 +182,64 @@ from vllm.v1.worker.workspace import lock_workspace, use_workspace_lane
 
 logger = init_logger(__name__)
 
+import json as _json
+import os as _os
+import time as _time
+from collections import deque as _deque
+
+# Experiment: direct per-step CUDA timing (events around execute_model ->
+# sample_tokens), drained without synchronizing, to JSONL.
+_EXP_STEP_TRACE = _os.environ.get("VLLM_EXP_STEP_TRACE")
+
+
+class _ExpStepTimer:
+    def __init__(self, path: str):
+        self.fh = open(path, "a", buffering=1)
+        self.pending: _deque = _deque()
+        self.current = None
+        self.step = 0
+
+    def begin(self, scheduler_output, batch_desc):
+        start = torch.cuda.Event(enable_timing=True)
+        start.record()
+        self.current = {
+            "step": self.step,
+            "t": _time.monotonic(),
+            "num_reqs": len(scheduler_output.num_scheduled_tokens),
+            "num_tokens": scheduler_output.total_num_scheduled_tokens,
+            "padded_tokens": batch_desc.num_tokens,
+            "cg_mode": str(batch_desc.cg_mode),
+            "uniform_decode": bool(batch_desc.uniform_decode),
+            "max_query_len": max(scheduler_output.num_scheduled_tokens.values()),
+            "_start": start,
+        }
+        self.step += 1
+
+    def end(self):
+        if self.current is None:
+            return
+        end = torch.cuda.Event(enable_timing=True)
+        end.record()
+        self.current["_end"] = end
+        self.pending.append(self.current)
+        self.current = None
+        self.drain()
+
+    def drain(self, force: bool = False):
+        while self.pending:
+            rec = self.pending[0]
+            if not force and not rec["_end"].query():
+                break
+            if force:
+                rec["_end"].synchronize()
+            rec = self.pending.popleft()
+            rec["cuda_ms"] = round(rec["_start"].elapsed_time(rec["_end"]), 3)
+            del rec["_start"], rec["_end"]
+            self.fh.write(_json.dumps(rec) + "\n")
+
+
+_EXP_STEP_TIMER = _ExpStepTimer(_EXP_STEP_TRACE) if _EXP_STEP_TRACE else None
+
 
