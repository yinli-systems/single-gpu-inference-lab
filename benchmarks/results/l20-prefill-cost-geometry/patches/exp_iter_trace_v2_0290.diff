diff --git a/vllm/v1/engine/core.py b/vllm/v1/engine/core.py
index 7da7f2e0..f2110dde 100644
--- a/vllm/v1/engine/core.py
+++ b/vllm/v1/engine/core.py
@@ -96,6 +96,72 @@ from vllm.version import __version__ as VLLM_VERSION
 
 logger = init_logger(__name__)
 
+import json as _json
+import os as _os
+
+# Experiment: per-iteration step-cost trace (scheduler geometry + engine wait) to JSONL.
+_EXP_ITER_TRACE = _os.environ.get("VLLM_EXP_ITER_TRACE")
+_EXP_ITER_TRACE_FH = None
+
+
+def _exp_trace_iteration(scheduler_output, details, start_time: float) -> None:
+    """Append one JSON line with the iteration's cost coordinates.
+
+    ``ms`` is the engine's wait for this iteration's result (NOT GPU time;
+    execution overlaps scheduling). Prefill rows carry each request's KV depth
+    (computed tokens before this step) and chunk; decode rows carry the batch
+    and KV depths. The model runner writes direct CUDA timing separately.
+    """
+    global _EXP_ITER_TRACE_FH
+    if _EXP_ITER_TRACE_FH is None:
+        _EXP_ITER_TRACE_FH = open(_EXP_ITER_TRACE, "a", buffering=1)
+    cached = scheduler_output.scheduled_cached_reqs
+    new_ids = {r.req_id for r in scheduler_output.scheduled_new_reqs}
+    depth_of = {r.req_id: r.num_computed_tokens for r in scheduler_output.scheduled_new_reqs}
+    for req_id, depth in zip(cached.req_ids, cached.num_computed_tokens):
+        depth_of[req_id] = depth
+    ctx_chunks, ctx_depths, gen_depths = [], [], []
+    for req_id, n in scheduler_output.num_scheduled_tokens.items():
+        depth = depth_of.get(req_id, 0)
+        if req_id in new_ids or cached.is_context_phase(req_id):
+            ctx_chunks.append(n)
+            ctx_depths.append(depth)
+        else:
+            gen_depths.append(depth)
+
+    def var(xs):
+        if len(xs) < 2:
+            return 0.0
+        m = sum(xs) / len(xs)
+        return sum((x - m) ** 2 for x in xs) / len(xs)
+
+    # attention-work proxy: sum over prefill rows of q * (kv + q/2), plus decode rows kv
+    attn_proxy = sum(q * (kv + q / 2) for q, kv in zip(ctx_chunks, ctx_depths)) + sum(gen_depths)
+    _EXP_ITER_TRACE_FH.write(
+        _json.dumps(
+            {
+                "i": details.iteration_index,
+                "t": start_time,
+                "ms": round(details.elapsed_ms, 3),
+                "ctx_reqs": len(ctx_chunks),
+                "ctx_tokens": sum(ctx_chunks),
+                "ctx_chunks": ctx_chunks,
+                "ctx_depths": ctx_depths,
+                "ctx_kv_sum": sum(ctx_depths),
+                "ctx_kv_max": max(ctx_depths, default=0),
+                "ctx_kv_var": var(ctx_depths),
+                "gen_reqs": len(gen_depths),
+                "gen_tokens": sum(scheduler_output.num_scheduled_tokens.values()) - sum(ctx_chunks),
+                "gen_kv_sum": sum(gen_depths),
+                "gen_kv_max": max(gen_depths, default=0),
+                "gen_kv_var": var(gen_depths),
+                "total_tokens": scheduler_output.total_num_scheduled_tokens,
+                "attn_proxy": attn_proxy,
+            }
+        )
+        + "\n"
+    )
+
 
 HANDSHAKE_TIMEOUT_MINS = 5
 
