+    flat = LogprobsLists(
+        logprob_token_ids=[[1], [2], [3]],
+        logprobs=[[-0.5], [-0.6], [-0.7]],
+        sampled_token_ranks=[1, 1, 1],
+        cu_num_generated_tokens=None,
+    )
+    assert flat.sampled_logprobs(1, 2) == pytest.approx([-0.6, -0.7])
+
