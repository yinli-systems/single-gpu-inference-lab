+
+    assert actual.token_ids.tolist() == expected.token_ids.tolist()
+    assert actual.offsets.tolist() == expected.offsets.tolist()
+    assert actual.cu_num_generated_tokens == expected.cu_num_generated_tokens
+    assert all(len(row) <= top_k for row in actual.to_nested_list())
+
