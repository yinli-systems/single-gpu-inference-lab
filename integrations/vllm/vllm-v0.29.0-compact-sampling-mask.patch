+    num_sampled = torch.ones(batch, dtype=torch.int32, device=DEVICE_TYPE)
+    num_sampled[5] = 0
+    num_sampled_np = num_sampled.cpu().numpy()
+
+    bitpacked = SamplingMaskTensors.from_logits(processed, num_sampled)
+    compact = SamplingMaskTensors.from_logits(processed, num_sampled, max_support=16)
