+    def _sampling_mask_max_support(self, idx_mapping_np: np.ndarray) -> int | None:
+        """Bound on the sampling-mask support for the scheduled requests.
+
+        The sampling mask feature requires ``top_k > 0`` per request, and every
+        later filter (top-p, min-p, bias, penalties) can only shrink the
+        surviving set, so the support never exceeds the batch's largest
+        ``top_k``. That value lives in host memory, so choosing the compact
+        layout costs no device sync. Returns ``None`` (bit-packed layout) when
+        the bound is missing or larger than the configured cap.
+        """
+        if not envs.VLLM_SAMPLING_MASK_COMPACT:
+            return None
+        top_k = self.sampling_states.top_k.np[idx_mapping_np]
+        if top_k.size == 0:
+            return None
+        max_top_k = int(top_k.max())
+        if max_top_k <= 0 or max_top_k >= self.sampling_states.vocab_size:
+            return None
+        if max_top_k > envs.VLLM_SAMPLING_MASK_COMPACT_MAX_K:
+            return None
+        return 1 << (max_top_k - 1).bit_length() if max_top_k > 1 else 1
