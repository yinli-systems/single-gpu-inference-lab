+@triton.jit
+def _pack_compact_support_kernel(
+    logits_ptr,
+    logits_row_stride,
+    logits_col_stride,
+    num_sampled_tokens_ptr,
+    token_ids_ptr,
+    token_ids_row_stride,
+    counts_ptr,
+    overflow_ptr,
+    vocab_size,
+    MAX_SUPPORT: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    """Emit the finite-logit support as compact, ascending token IDs.
+
+    Same keep rule as ``_pack_sampling_mask_kernel`` (finite logits of rows
+    that sampled a token). The support of a request with ``top_k = k`` has at
+    most ``k`` entries, so when every request in the batch has a bounded
+    ``top_k`` the caller can size ``MAX_SUPPORT`` from host-side state and the
+    D2H copy shrinks from ``ceil(V / 8)`` bytes per row to ``4 * MAX_SUPPORT``,
+    and the host no longer unpacks ``V`` bits per row. ``overflow`` is set
+    when a row's support exceeds ``MAX_SUPPORT``; the caller must treat that
+    as an error rather than a truncated mask.
+    """
+    req_idx = tl.program_id(0)
+    is_active = tl.load(num_sampled_tokens_ptr + req_idx) > 0
+    count = tl.zeros((), dtype=tl.int32)
+
+    for start_idx in range(0, vocab_size, BLOCK_SIZE):
+        offsets = start_idx + tl.arange(0, BLOCK_SIZE)
+        valid = offsets < vocab_size
+        logits = tl.load(
+            logits_ptr + req_idx * logits_row_stride + offsets * logits_col_stride,
+            mask=valid,
+            other=-float("inf"),
+        )
+        keep = (logits > -float("inf")) & (logits < float("inf")) & is_active
+        keep_i = keep.to(tl.int32)
+        # Inclusive prefix sum within the tile gives each kept token its
+        # slot; the running count offsets across tiles. Slots beyond
+        # MAX_SUPPORT are dropped and reported through ``overflow``.
+        position = count + tl.cumsum(keep_i, axis=0) - 1
+        tl.store(
+            token_ids_ptr + req_idx * token_ids_row_stride + position,
+            offsets.to(tl.int32),
+            mask=keep & (position < MAX_SUPPORT),
+        )
+        count += tl.sum(keep_i, axis=0)
+
+    tl.store(counts_ptr + req_idx, count)
+    tl.store(overflow_ptr + req_idx, (count > MAX_SUPPORT).to(tl.int32))
+
