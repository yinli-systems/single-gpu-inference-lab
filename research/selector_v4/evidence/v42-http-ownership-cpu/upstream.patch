+class TestDelayedAbortOwnership(CustomTestCase):
+    """Delayed HTTP cleanup must never abort a newer request reusing the RID."""
+
+    async def _run_cleanup(self, tm, obj, during_sleep=None):
+        entered = asyncio.Event()
+        release = asyncio.Event()
+
+        async def controlled_sleep(_seconds):
+            entered.set()
+            await release.wait()
+
+        with patch(
+            "sglang.srt.managers.tokenizer_manager.asyncio.sleep",
+            side_effect=controlled_sleep,
+        ):
+            task = asyncio.create_task(tm.create_abort_task(obj)())
+            await entered.wait()
+            if during_sleep is not None:
+                during_sleep()
+            release.set()
+            await task
+
+    def test_reused_rid_does_not_abort_replacement(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rid = "reused-rid"
+        obj = Mock(spec=GenerateReqInput)
+        obj.is_single = True
+        obj.rid = rid
+        original = _make_req_state(rid)
+        original.obj = obj
+        replacement = _make_req_state(rid)
+        tm.rid_to_state[rid] = original
+
+        asyncio.run(
+            self._run_cleanup(
+                tm,
+                obj,
+                during_sleep=lambda: tm.rid_to_state.__setitem__(rid, replacement),
+            )
+        )
+        tm.abort_request.assert_not_called()
+        self.assertIs(tm.rid_to_state[rid], replacement)
+
+    def test_replacement_present_before_cleanup_starts_is_not_aborted(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rid = "replacement-before-start"
+        obj = Mock(spec=GenerateReqInput)
+        obj.is_single = True
+        obj.rid = rid
+        replacement = _make_req_state(rid)
+        tm.rid_to_state[rid] = replacement
+
+        asyncio.run(self._run_cleanup(tm, obj))
+        tm.abort_request.assert_not_called()
+        self.assertIs(tm.rid_to_state[rid], replacement)
+
+    def test_same_request_object_new_state_generation_is_not_aborted(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rid = "same-object-new-state"
+        obj = Mock(spec=GenerateReqInput)
+        obj.is_single = True
+        obj.rid = rid
+        original = _make_req_state(rid)
+        original.obj = obj
+        replacement = _make_req_state(rid)
+        replacement.obj = obj
+        tm.rid_to_state[rid] = original
+
+        asyncio.run(
+            self._run_cleanup(
+                tm,
+                obj,
+                during_sleep=lambda: tm.rid_to_state.__setitem__(rid, replacement),
+            )
+        )
+        tm.abort_request.assert_not_called()
+        self.assertIs(tm.rid_to_state[rid], replacement)
+
+    def test_absent_at_start_then_replacement_appears_is_not_aborted(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rid = "late-replacement"
+        obj = Mock(spec=GenerateReqInput)
+        obj.is_single = True
+        obj.rid = rid
+        replacement = _make_req_state(rid)
+
+        asyncio.run(
+            self._run_cleanup(
+                tm,
+                obj,
+                during_sleep=lambda: tm.rid_to_state.__setitem__(rid, replacement),
+            )
+        )
+        tm.abort_request.assert_not_called()
+        self.assertIs(tm.rid_to_state[rid], replacement)
+
+    def test_batch_aborts_only_members_still_owned_by_original_generation(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rids = ["batch-live", "batch-replaced"]
+        children = []
+        for rid in rids:
+            child = Mock(spec=GenerateReqInput)
+            child.rid = rid
+            children.append(child)
+        obj = MagicMock(spec=GenerateReqInput)
+        obj.is_single = False
+        obj.rid = rids
+        obj.__getitem__.side_effect = children
+        original = []
+        for rid, child in zip(rids, children):
+            state = _make_req_state(rid)
+            state.obj = child
+            state.dispatched = True
+            tm.rid_to_state[rid] = state
+            original.append(state)
+        replacement = _make_req_state(rids[1])
+
+        asyncio.run(
+            self._run_cleanup(
+                tm,
+                obj,
+                during_sleep=lambda: tm.rid_to_state.__setitem__(rids[1], replacement),
+            )
+        )
+        tm.abort_request.assert_called_once_with(rids[0])
+        self.assertIs(tm.rid_to_state[rids[0]], original[0])
+        self.assertIs(tm.rid_to_state[rids[1]], replacement)
+
+    def test_original_live_request_is_still_aborted(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        rid = "live-rid"
+        obj = Mock(spec=GenerateReqInput)
+        obj.is_single = True
+        obj.rid = rid
+        state = _make_req_state(rid)
+        state.obj = obj
+        state.dispatched = True
+        tm.rid_to_state[rid] = state
+
+        asyncio.run(self._run_cleanup(tm, obj))
+        tm.abort_request.assert_called_once_with(rid)
+
+    def test_parallel_samples_are_owned_after_parent_state_is_removed(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = _make_generate_obj("parallel-parent", is_single=True)
+        tm._init_req_state(obj)
+        for rid in ("parallel-child-0", "parallel-child-1"):
+            child = _make_generate_obj(rid, is_single=True)
+            tm._init_req_state(child, abort_owner=obj)
+            tm.rid_to_state[rid].dispatched = True
+        del tm.rid_to_state[obj.rid]
+
+        asyncio.run(self._run_cleanup(tm, obj))
+
+        self.assertEqual(
+            [call.args[0] for call in tm.abort_request.call_args_list],
+            ["parallel-child-0", "parallel-child-1"],
+        )
+
+    def test_parallel_sampling_handler_registers_expanded_requests(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = GenerateReqInput(
+            input_ids=[1], rid="parallel-parent", sampling_params={"n": 2}
+        )
+        obj.normalize_batch_and_arguments()
+        obj.received_time = 0.0
+        tm._tokenize_one_request = AsyncMock(
+            return_value=SimpleNamespace(
+                rid=obj.rid[0],
+                mm_inputs=None,
+                sampling_params=SimpleNamespace(max_new_tokens=128),
+            )
+        )
+
+        async def send_one(tokenized_obj):
+            tm.rid_to_state[tokenized_obj.rid].dispatched = True
+
+        tm._send_one_request = AsyncMock(side_effect=send_one)
+        tm._collect_batch_responses = AsyncMock(return_value=[])
+
+        async def finish_prefix(request_obj, request):
+            tm.rid_to_state.pop(request_obj.rid)
+            yield {}
+
+        tm._wait_one_response = finish_prefix
+
+        async def drive():
+            tm._init_req_state(obj)
+            handler = tm._handle_batch_request(obj)
+            await handler.__anext__()
+            sample_rids = {
+                rid for rid, state in tm.rid_to_state.items() if state.dispatched
+            }
+            self.assertEqual(len(sample_rids), 2)
+            self.assertTrue(set(obj.rid).isdisjoint(sample_rids))
+            await self._run_cleanup(tm, obj)
+            self.assertEqual(
+                {call.args[0] for call in tm.abort_request.call_args_list},
+                sample_rids,
+            )
+            self.assertEqual(set(tm.rid_to_state), sample_rids)
+            await handler.aclose()
+
+        asyncio.run(drive())
+
+    def test_undispatched_owned_request_is_released_locally(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = _make_generate_obj("never-dispatched", is_single=True)
+        tm._init_req_state(obj)
+        event = asyncio.Event()
+        tm.encoder_dispatch_ready[obj.rid] = event
+
+        asyncio.run(self._run_cleanup(tm, obj))
+
+        tm.abort_request.assert_not_called()
+        self.assertNotIn(obj.rid, tm.rid_to_state)
+        self.assertNotIn(obj.rid, tm.encoder_dispatch_ready)
+        self.assertTrue(event.is_set())
+
+    def test_parallel_sample_replacement_is_not_aborted(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = _make_generate_obj("parallel-parent", is_single=True)
