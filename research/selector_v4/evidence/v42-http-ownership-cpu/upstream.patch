+
+    def test_delayed_cleanup_does_not_retain_completed_state(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = _make_generate_obj("weak-state", is_single=True)
+        tm._init_req_state(obj)
+        state_ref = weakref.ref(tm.rid_to_state[obj.rid])
+
+        def complete():
+            del tm.rid_to_state[obj.rid]
+            gc.collect()
+            self.assertIsNone(state_ref())
+
+        asyncio.run(self._run_cleanup(tm, obj, during_sleep=complete))
+        tm.abort_request.assert_not_called()
+
+    def test_removed_parallel_sample_is_ignored(self):
+        tm = _make_tokenizer_manager(self)
+        tm.abort_request = Mock()
+        obj = _make_generate_obj("parallel-parent", is_single=True)
+        child = _make_generate_obj("expired-child", is_single=True)
+        tm._init_req_state(child, abort_owner=obj)
+        del tm.rid_to_state[child.rid]
+        gc.collect()
+
+        asyncio.run(self._run_cleanup(tm, obj))
+        tm.abort_request.assert_not_called()
+
+    def test_request_cleanup_metadata_preserves_request_pickling(self):
+        tm = _make_tokenizer_manager(self)
+        obj = GenerateReqInput(input_ids=[1, 2], rid="pickle-request")
+        obj.received_time = 0.0
+        tm._init_req_state(obj)
+
+        restored = pickle.loads(pickle.dumps(obj))
+
+        self.assertEqual(restored.rid, obj.rid)
+        self.assertEqual(restored.input_ids, obj.input_ids)
+
+    def test_finished_or_removed_original_is_not_aborted(self):
+        for removed in (False, True):
+            with self.subTest(removed=removed):
+                tm = _make_tokenizer_manager(self)
+                tm.abort_request = Mock()
+                rid = f"done-{removed}"
+                obj = Mock(spec=GenerateReqInput)
+                obj.is_single = True
+                obj.rid = rid
+                state = _make_req_state(rid)
+                state.obj = obj
+                tm.rid_to_state[rid] = state
+
+                def finish_or_remove():
+                    if removed:
+                        del tm.rid_to_state[rid]
+                    else:
+                        state.finished = True
+
+                asyncio.run(self._run_cleanup(tm, obj, finish_or_remove))
+                tm.abort_request.assert_not_called()
+
