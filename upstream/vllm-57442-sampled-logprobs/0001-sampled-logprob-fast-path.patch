+        "token_ids": [1, 2, 3],
+        "sampling_params": {"max_tokens": 5, "temperature": 0.0},
+        "stream": False,
+        "return_token_logprobs": True,
+    }
+    resp = await client.post(GEN_ENDPOINT, json=payload)
